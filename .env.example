# JWT & Security
# `openssl rand -hex 32`
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Deepseek API
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_API_BASE=https://api.deepseek.com

# HuggingFace Hub
HF_TOKEN=
HF_USERNAME=quannguyen204

# PostgreSQL Database
POSTGRES_USER=postgresadmin
POSTGRES_PASSWORD=postgresadmin
POSTGRES_DB=medical_rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redisadmin
# REDIS_PASSWORD=102ce5214cbb235fe69a059f99768a0a
REDIS_DB=0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PASSWORD=elasticadmin
# ELASTICSEARCH_PASSWORD=1db520e1e1e9b8f44d7c2380198021d4
ELASTICSEARCH_URL=http://${ELASTICSEARCH_HOST}:${ELASTICSEARCH_PORT}

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# vLLM Model Serving
VLLM_HOST=localhost
VLLM_PORT=8001
VLLM_URL=http://${VLLM_HOST}:${VLLM_PORT}
VLLM_MODEL=qwen3-medical-gen

# Triton Inference Server
TRITON_HOST=localhost
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_URL=http://${TRITON_HOST}:${TRITON_HTTP_PORT}

# Cohere API
COHERE_API_KEY=

TAVILY_API_KEY=

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_NAME="Vietnamese Medical RAG QA System"
APP_VERSION=2.0.0

# Chainlit Configuration
CHAINLIT_AUTH_SECRET=
CHAINLIT_URL=http://localhost:8501
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=vietnamese-medical-rag
WANDB_ENTITY=

# Cache Configuration
CACHE_TTL_EMBEDDING=3600
CACHE_TTL_SEARCH=600

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
RRF_K=60

# Model Paths
MODEL_PATH_GENERATION=./models/qwen3/generation
MODEL_PATH_EMBEDDING=./models/qwen3/embedding
MODEL_PATH_RERANKER=./models/qwen3/reranker
MODEL_PATH_GUARD=./models/qwen3/guardrails

# Fine-tuning Configuration
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LEARNING_RATE=2e-4
BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
MAX_EPOCHS=3
MAX_SEQ_LENGTH=2048

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
GPU_MEMORY_UTILIZATION=0.7

# Rate Limiting
RATE_LIMIT_REGISTRATION=10/minute
RATE_LIMIT_CHAT=100/minute

# Monitoring (Optional - P5)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=grafanaadmin
# GRAFANA_ADMIN_PASSWORD=f3e81b3c75ecc8433f7b026f8061ab41
LOKI_PORT=3100
TEMPO_PORT=3200
