[run]
source = backend/src
omit = 
    */tests/*
    */migrations/*
    */alembic/*
    */node_modules/*
    */__pycache__/*
    */site-packages/*
    */.venv/*
    */venv/*

[report]
precision = 2
skip_empty = True
show_missing = True

[html]
directory = htmlcov
title = Vietnamese Medical RAG - Coverage Report
