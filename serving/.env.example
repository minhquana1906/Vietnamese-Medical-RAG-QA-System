# ============================================================================
# vLLM Docker Compose Environment Variables
# Copy this file to .env and adjust values as needed
# ============================================================================

# ----------------------------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------------------------

# Model to serve (HuggingFace repo ID or local path)
# Examples:
#   - Qwen/Qwen2.5-3B-Instruct (HuggingFace Hub, auto-download)
#   - Qwen/Qwen2.5-7B-Instruct
#   - /models/qwen3-medical-v1 (local path, must exist in container)
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# Local model path (optional, if using local models)
# This directory will be mounted to /models in container
MODEL_PATH=./models

# ----------------------------------------------------------------------------
# Network & Port Configuration
# ----------------------------------------------------------------------------

# External port (host machine)
VLLM_PORT=8001

# Internal port (inside container, usually keep as 8000)
VLLM_INTERNAL_PORT=8000

# Host binding
VLLM_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# GPU Configuration
# ----------------------------------------------------------------------------

# CUDA visible devices (comma-separated for multi-GPU)
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=0

# Number of GPUs to use
GPU_COUNT=1

# Tensor parallel size (for multi-GPU inference)
TENSOR_PARALLEL_SIZE=1

# GPU memory utilization (0.0-1.0)
GPU_MEMORY_UTIL=0.7

# ----------------------------------------------------------------------------
# Model Serving Configuration
# ----------------------------------------------------------------------------

# Maximum model context length
MAX_MODEL_LEN=8192

# Data type (auto, float16, bfloat16)
DTYPE=auto

# Trust remote code (required for some models like Qwen)
TRUST_REMOTE_CODE=true

# ----------------------------------------------------------------------------
# LoRA Configuration (for fine-tuned adapters)
# ----------------------------------------------------------------------------

# Enable LoRA support
ENABLE_LORA=false

# LoRA modules to load (format: name=path,name2=path2)
# Example: medical-v1=/models/lora/medical-v1,medical-v2=/models/lora/medical-v2
LORA_MODULES=

# Max number of LoRA adapters to serve simultaneously
MAX_LORAS=1

# Max LoRA rank
MAX_LORA_RANK=16

# ----------------------------------------------------------------------------
# HuggingFace Hub Configuration
# ----------------------------------------------------------------------------

# HuggingFace token (required for private models)
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=

# ----------------------------------------------------------------------------
# Resource Limits
# ----------------------------------------------------------------------------

# Memory limit for container
MEMORY_LIMIT=11G
