name: "qwen3_reranker"
backend: "python"
max_batch_size: 16
input [
  {
    name: "QUERY"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "DOCUMENTS"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]
output [
  {
    name: "SCORES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 100000
}

parameters: {
  key: "EXECUTION_ENV_PATH"
  value: {string_value: "$$TRITON_MODEL_DIRECTORY/../../python_env.tar.gz"}
}
