name: "qwen3_guard"
backend: "python"
max_batch_size: 32
input [
  {
    name: "INPUT_TEXT"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]
output [
  {
    name: "IS_SAFE"
    data_type: TYPE_BOOL
    dims: [ -1 ]
  },
  {
    name: "SAFETY_SCORE"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 50000
}

# Removed EXECUTION_ENV_PATH - use container's default Python environment

